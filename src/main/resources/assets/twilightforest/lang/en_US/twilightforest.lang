# Twilight Forest -- English (US).
#
# BTA scans assets/<namespace>/lang/en_US/ for any *.lang and parses each as a Properties file, so
# the filename here is free; the directory is not.
#
# Names are Benimatic's own wherever he wrote one -- taken from TFBiomeBase's setBiomeName calls,
# mod_TwilightForest's registerEntityID calls and TFBlocks' addName calls. The handful that are not
# are marked, and every one of them exists because this port splits something upstream kept whole.
#
# --- ⚠️ Key formats, which are not obvious --------------------------------------------------------
# blocks    tile.<modid>.<translation key>.name    -- the key HalpLibe's build() was given, dots and
#                                                     all, NOT the texture name with underscores
# items     item.<modid>.<key>.name
# biomes    biome.<key>                            -- no .name suffix
# mobs      guidebook.section.mob.<entity id>.name -- BTA 8.0 resolves mob names through the
#                                                     guidebook namespace, not entity.*
#
# A missing key is not silent: BTA logs "Missing translation in default language: <key>" once per
# key as the creative menu is built, which is how the gaps below were found rather than guessed.

# --- Biomes -----------------------------------------------------------------------------------------
# All fourteen. ⚠️ Three of these keys CHANGED when the port moved from 1.p4 to 1.7.1 -- "clearings"
# became "clearing", "highland" became "highlands" and "mushroom" became "mushrooms" -- so the old
# entries matched nothing and those biomes displayed a raw key.
biome.twilight.lake=Twilight Lake
biome.twilight.forest=Twilight Forest
biome.twilight.forest_variant=Twilight Forest Variant
biome.twilight.highlands=Highlands
biome.twilight.mushrooms=Mushrooms
biome.twilight.swamp=Twilight Swamp
biome.twilight.stream=Twilight Stream
biome.twilight.snow=Snowfield
biome.twilight.glacier=Glacier
biome.twilight.clearing=Twilight Clearing
biome.twilight.clearing_border=Clearing Border
biome.twilight.lake_border=Lake Border
biome.twilight.deep_mushrooms=Lots of Mushrooms
biome.twilight.large_feature=Major Feature
# From the 1.15.4 donor -- its own setBiomeName strings.
biome.twilight.dark_forest=Dark Forest
biome.twilight.enchanted_forest=Enchanted Forest

# --- World type and dimension -----------------------------------------------------------------------
worldType.twilightforest.default.name=Twilight Forest
worldType.twilightforest.default.desc=A forest under a sky that never moves.
dimension.twilightforest.name=Twilight Forest

# --- Mobs -------------------------------------------------------------------------------------------
guidebook.section.mob.wildboar.name=Wild Boar
guidebook.section.mob.bighorn.name=Bighorn Sheep
guidebook.section.mob.wilddeer.name=Wild Deer
guidebook.section.mob.penguin.name=Penguin
guidebook.section.mob.swarmspider.name=Swarm Spider
guidebook.section.mob.hedgespider.name=Hedge Spider
guidebook.section.mob.redcap.name=Redcap
guidebook.section.mob.skeletondruid.name=Skeleton Druid
guidebook.section.mob.wraith.name=Twilight Wraith
guidebook.section.mob.hostilewolf.name=Hostile Wolf
guidebook.section.mob.naga.name=Naga
guidebook.section.mob.nagasegment.name=Naga Segment

# The ambient four, from the 1.15.4 donor -- its own registerTFCreature strings.
guidebook.section.mob.bunny.name=Forest Bunny
guidebook.section.mob.squirrel.name=Forest Squirrel
guidebook.section.mob.tinybird.name=Tiny Bird
guidebook.section.mob.raven.name=Forest Raven

# The small hostiles, also the donor's own registerTFCreature strings.
guidebook.section.mob.kobold.name=Twilight Kobold
guidebook.section.mob.mosquitoswarm.name=Mosquito Swarm
guidebook.section.mob.firebeetle.name=Fire Beetle
guidebook.section.mob.slimebeetle.name=Slime Beetle
guidebook.section.mob.pinchbeetle.name=Pinch Beetle
guidebook.section.mob.redcapsapper.name=Redcap Sapper

# The two projectiles. Upstream never names them -- they are not registered as mobs at all, only as
# network-visible entities -- so these are this port's own, and exist because BTA asks every
# registered entity for a display name whether or not anything shows it.
guidebook.section.mob.projectile.name=Magic Bolt
guidebook.section.mob.naturebolt.name=Nature Bolt

# --- Blocks -----------------------------------------------------------------------------------------
# The log and leaf names are upstream's three metadata variants, which this port registers as
# separate blocks -- so the names carry over one for one.
tile.twilightforest.log.twilight_oak.name=Twilight Oak Log
tile.twilightforest.log.canopy.name=Canopy Tree Log
tile.twilightforest.log.mangrove.name=Mangrove Log
tile.twilightforest.leaves.twilight_oak.name=Twilight Oak Leaves
tile.twilightforest.leaves.canopy.name=Canopy Tree Leaves
tile.twilightforest.leaves.mangrove.name=Mangrove Leaves

# --- From the 1.15.4 donor. Benimatic's own strings, out of its lang/en_US.xml. ---
# tile.TFHedge.1 is "Darkwood Leaves" -- so even upstream calls the hedge variant leaves in the UI,
# while building it out of the hedge block. The name is his; the block choice is documented on
# BlockLogicTFHedge.harmless.
#
# ⚠️ ONE DEVIATION: upstream's tile.TFLog.3 is "Darkwood Wood", because 1.15.4 names the whole family
# "<species> Wood". 1.7.1 -- the version being ported, and the one the three names above follow --
# names them "<species> Log". Kept as Log for consistency with its siblings, which also spares us
# "Darkwood Wood".
tile.twilightforest.log.darkwood.name=Darkwood Log
tile.twilightforest.leaves.darkwood.name=Darkwood Leaves
tile.twilightforest.leaves.rainbow.name=Rainbow Oak Leaves
# tile.TFRoots.0 is "Roots". Its metadata-1 sibling "Liveroots" is not ported -- see
# BlockLogicTFRoots -- so there is no name for it here either.
tile.twilightforest.roots.name=Roots

# ⚠️ Upstream has ONE mazestone with three metadata variants and one name for all three. Splitting
# it into three blocks means inventing two names; these follow the vanilla blocks each variant
# disguises itself as, which is the only honest reading of what they are.
tile.twilightforest.mazestone.name=Mazestone
tile.twilightforest.mazestone.cobble.name=Mazestone Cobblestone
tile.twilightforest.mazestone.mossy.name=Mossy Mazestone

tile.twilightforest.hedge.name=Hedge
tile.twilightforest.firefly.name=Firefly
tile.twilightforest.cicada.name=Cicada
tile.twilightforest.boss_spawner.name=Boss Spawner
tile.twilightforest.portal.twilightforest.name=Twilight Forest Portal
# ⚠️ This line described the 1.p4 port's INVENTED portal -- a mossy cobblestone frame, built because
# 1.p4 shipped no portal block at all. 1.7.1 has a real BlockTFPortal and it is nothing like a nether
# portal: nothing is crafted, nothing is placed, and no frame exists. You find a 2x2 pool of water in
# a clearing, ringed by flowering grass, and throw a diamond in. See BlockLogicTFPortal.
tile.twilightforest.portal.twilightforest.desc=A pool in a flowering clearing. Throw in a diamond.

# --- Items ------------------------------------------------------------------------------------------
item.twilightforest.naga_scale.name=Naga Scale

