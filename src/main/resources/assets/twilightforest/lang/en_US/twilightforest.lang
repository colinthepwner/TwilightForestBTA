item.twilightforest.naga_scale.name=Naga Scale
item.twilightforest.naga_scale_tunic.name=Naga Scale Tunic
item.twilightforest.naga_scale_leggings.name=Naga Scale Leggings

# Benimatic's own, from TFItems.registerTFItem(towerKey, "Tower Key").
item.twilightforest.tower_key.name=Tower Key

